---
import Logo from './Logo.astro';
import { categories } from '../site.config.mjs';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const actual = (href: string) => path === href ? 'page' : path.startsWith(href) ? 'location' : undefined;
---

<header class="site-header">
  <div class="header-bar">
    <div class="header-inner container">
      <div class="header-brand"><Logo /></div>


      <nav id="site-primary-nav" class="site-nav" aria-label="Principal">
        <ul class="site-menu">
          {categories.map((category) => {
            const href = `/${category.id}/`;
            return (
              <li>
                <a href={href} aria-current={actual(href)}>
                  {category.nav}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <a class="community-link" href="/comunidad/" aria-label="Comunidad docente"
        aria-current={actual('/comunidad/')}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"
          stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>
          <circle cx="9" cy="7" r="4"/>
        </svg>
        <span class="community-label" aria-hidden="true">Comunidad</span>
      </a>
    </div>
  </div>
</header>

<script>
  // Keep the current section visible without hiding navigation behind a menu.
  const navigation = document.getElementById('site-primary-nav');
  const current = navigation?.querySelector<HTMLElement>('a[aria-current]');
  if (navigation && current && window.matchMedia('(width < 72rem)').matches) {
    navigation.scrollLeft = Math.max(0, current.offsetLeft - navigation.offsetLeft - 12);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    container-type: scroll-state;
    container-name: site-header;
  }
  .header-bar {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 200ms var(--ease-out), border-color 200ms var(--ease-out);
  }
  @container site-header scroll-state(stuck: top) {
    .header-bar {
      border-bottom-color: transparent;
      box-shadow: 0 1px 0 var(--line), 0 8px 24px oklch(0.21 0.02 265 / 0.06);
    }
  }

  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "brand community" "nav nav";
    align-items: center;
    gap: 0.25rem var(--space-2);
    padding-block: 0.35rem;
  }
  .header-brand { grid-area: brand; }
  .menu-toggle,
  .site-nav[hidden] { display: none; }
  .close-icon,
  .menu-toggle[aria-expanded="true"] .menu-icon { display: none; }
  .menu-toggle[aria-expanded="true"] .close-icon { display: inline; }
  .site-nav {
    grid-area: nav;
    min-width: 0;
  }
  .site-menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.125rem clamp(0.375rem, 1.3vw, 1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-menu a,
  .community-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-menu a {
    min-width: 44px;
    padding-inline: clamp(0.4rem, 1vw, 0.7rem);
    color: var(--ink);
    font-size: clamp(0.875rem, 1.6vw, 1rem);
  }
  .site-menu a:hover {
    background: var(--paper-2);
  }
  .site-menu a[aria-current],
  .community-link[aria-current] {
    background: var(--accent);
    color: var(--paper);
  }
  .community-link {
    grid-area: community;
    justify-self: end;
    position: relative;
    gap: var(--space-2);
    min-width: 44px;
    padding-inline: var(--space-3);
    background: var(--pizarra-500);
    color: var(--paper);
    font-size: 0.875rem;
  }
  .community-link:hover {
    box-shadow: inset 0 0 0 1px currentColor;
  }
  .community-link svg { flex: none; }

  @media (min-width: 72rem) {
    .header-inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: "brand nav community";
      gap: var(--space-5);
      min-height: var(--header-h);
      padding-block: 0.25rem;
    }
    .site-menu { justify-content: center; }
    .community-link { padding-inline: 0; }
    .community-label {
      position: absolute;
      z-index: 1;
      inset-block-start: calc(100% + 0.35rem);
      inset-inline-end: 0;
      background: var(--pizarra-900);
      color: var(--paper);
      border-radius: var(--radius-sm);
      padding: 0.35rem 0.6rem;
      pointer-events: none;
      visibility: hidden;
    }
    .community-link:is(:hover, :focus-visible) .community-label { visibility: visible; }
  }
  @media (width < 72rem) {
    :global(html) { scroll-padding-top: 10rem; }
  }
  @media (max-width: 20rem) {
    :global(html) { scroll-padding-top: 12.5rem; }
  }
  @media (max-width: 22rem) {
    .site-menu { column-gap: 0.375rem; }
    .site-menu a { padding-inline: 0.25rem; }
  }
  @media (max-width: 19rem) {
    .header-brand :global(.logotipo) { font-size: 1.2rem; }
    .community-link { gap: var(--space-1); padding-inline: var(--space-2); }
    .community-label { font-size: 0.8125rem; }
  }
  @media (width < 72rem) and (max-height: 34rem) {
    .site-header { position: relative; }
    :global(html) { scroll-padding-top: 1rem; }
  }
  /* Small screens: visible sections, native horizontal scrolling, 44px links. */
  @media (width < 72rem) {
    .header-inner { gap: 0 var(--space-2); padding-block: 0.35rem 0; }
    .site-nav { overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: thin; }
    .site-menu { flex-wrap: nowrap; width: max-content; gap: 0.25rem; padding-bottom: 0.25rem; }
    .site-menu a { padding-inline: 0.75rem; font-size: 0.9375rem; }
    .community-link { gap: 0.35rem; padding-inline: 0.65rem; }
    .community-label { display: inline; }
    :global(html) { scroll-padding-top: 8rem; }
  }
  @media (width < 22rem) {
    .header-brand :global(.logotipo) { font-size: 1.2rem; }
    .community-link { padding-inline: 0.5rem; font-size: 0.8125rem; }
    .community-link svg { width: 19px; height: 19px; }
  }
  @media (width < 72rem) and (max-height: 34rem) {
    :global(html) { scroll-padding-top: 1rem; }
  }
  @media (forced-colors: active) {
    .site-menu a[aria-current],
    .community-link {
      outline: 1px solid CanvasText;
    }
  }
</style>
