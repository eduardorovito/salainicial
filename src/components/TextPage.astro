---
// Plantilla para páginas de texto simple (privacidad, aviso legal, quiénes somos, contacto).
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  updated?: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <article class="container text-page">
    <h1>{title}</h1>
    {updated && <p class="updated">Última actualización: {updated}</p>}
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .text-page {
    padding-top: var(--space-7);
  }
  .updated {
    margin-top: var(--space-3);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .prose {
    margin-top: var(--space-6);
  }
</style>
