---
import SheetFrame from './SheetFrame.astro';
---

<SheetFrame title="Mi nombre y mis letras" label="Tres espacios para colocar el modelo de tu nombre, reconocer o representar su primera letra y ensayar una firma">
  <text x="15" y="53" font-size="4.6" font-weight="700">Busca tu tarjeta y colócala aquí.</text>
  <rect x="15" y="61" width="180" height="48" rx="3" fill="none" stroke="#6b625d" stroke-width="0.55" stroke-dasharray="2 1.2" />
  <text x="15" y="126" font-size="4.6" font-weight="700">Señala o representa la primera letra.</text>
  <rect x="15" y="134" width="47" height="43" rx="3" fill="none" stroke="#6b625d" stroke-width="0.55" />
  <text x="15" y="193" font-size="4.6" font-weight="700">Ensaya tu firma. Puedes copiar tu nombre o dibujar tu marca.</text>
  <rect x="15" y="201" width="180" height="67" rx="3" fill="none" stroke="#6b625d" stroke-width="0.55" />
  <path d="M21 226H189M21 249H189" fill="none" stroke="#9e9691" stroke-width="0.4" stroke-dasharray="1.5 1.2" />
</SheetFrame>
