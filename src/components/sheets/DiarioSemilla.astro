---
import SheetFrame from './SheetFrame.astro';

// Diario de observación: seis días para dibujar la planta y medirla en "dedos".
const ink = '#1f1a17';
const body = "'Atkinson Hyperlegible Next', Arial, sans-serif";
const sheetFont = "Andika, 'Atkinson Hyperlegible Next', Arial, sans-serif";

const dias = ['Día 1', 'Día 3', 'Día 5', 'Día 7', 'Día 10', 'Día 14'].map((nombre, i) => {
  const x = 15 + (i % 2) * 92;
  const y = 58 + Math.floor(i / 2) * 72;
  return { nombre, x, y, cx: x + 38 };
});
---

<SheetFrame title="Mi diario de la semilla" label="Diario de observación de una semilla con seis recuadros (días 1, 3, 5, 7, 10 y 14), cada uno con una maceta para dibujar la planta y cuadritos para medirla">
  <text x="15" y="50" font-size="4.6" font-family={body} fill={ink}>Mi semilla es de:</text>
  <line x1="53" y1="50.5" x2="195" y2="50.5" stroke={ink} stroke-width="0.35" />
  {
    dias.map((d) => (
      <g>
        <rect x={d.x} y={d.y} width="88" height="68" rx="4" fill="none" stroke="#c9c1bb" stroke-width="0.4" />
        <text x={d.x + 5} y={d.y + 8.5} font-size="5.4" font-family={sheetFont} font-weight="700" fill={ink}>{d.nombre}</text>
        <g fill="none" stroke={ink} stroke-width="0.7" stroke-linejoin="round">
          <rect x={d.cx - 11} y={d.y + 49} width="22" height="4" rx="0.8" />
          <path d={`M${d.cx - 9},${d.y + 53} L${d.cx - 7},${d.y + 63} H${d.cx + 7} L${d.cx + 9},${d.y + 53}`} />
        </g>
        {[0, 1, 2, 3, 4, 5].map((k) => (
          <rect x={d.x + 76} y={d.y + 57 - k * 7.5} width="6" height="6" rx="0.6" fill="none" stroke="#8f857e" stroke-width="0.5" />
        ))}
      </g>
    ))
  }
  <g font-family={body} fill="#4a423d" font-size="4">
    <text x="15" y="277">Dibuja tu planta cada vez que la observen y cuenta qué cambió.</text>
    <text x="15" y="283">Pinta un cuadrito por cada dedo que mide tu planta.</text>
  </g>
</SheetFrame>
