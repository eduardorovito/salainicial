---
import SheetFrame from './SheetFrame.astro';

const acciones = ['Caminaba o saltaba', 'Estaba posada', 'Volaba'];
---

<SheetFrame title="Aves del patio" label="Registro A4 de observación de aves. Permite marcar acciones y dibujar el lugar o un detalle.">
  <g fill="#1f1a17" font-family="'Atkinson Hyperlegible Next', Arial, sans-serif" font-size="4.7">
    <text x="15" y="52">Lugar:</text>
    <path d="M31 52.5h104" stroke="#796f67" stroke-width=".55" />
    <text x="15" y="66">Marca lo que viste. Puedes elegir más de una opción.</text>
    <g transform="translate(156 62)" stroke="#1f1a17" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round" fill="none">
      <path d="M5 28 0 19 8 22c5-2 6-10 15-10 3-1 3-7 10-7 4 0 7 3 7 6l5 2-6 2c-2 9-10 16-21 16H5Z M21 31v4l4 2m3-8v5l4 3 M15 23c5 0 9-3 12-7" />
      <circle cx="35" cy="10" r="1" fill="#1f1a17" stroke="none" />
    </g>
    {acciones.map((accion, indice) => (
      <g transform={`translate(22 ${83 + indice * 13})`}>
        <circle cx="3" cy="-1.8" r="3.5" fill="none" stroke="#1f1a17" stroke-width=".65" />
        <text x="13" y="0">{accion}</text>
      </g>
    ))}
    <rect x="15" y="121" width="180" height="27" rx="4" fill="none" stroke="#796f67" stroke-width=".55" />
    <circle cx="25" cy="132" r="3.5" fill="none" stroke="#1f1a17" stroke-width=".65" />
    <text x="35" y="134">Hoy no vimos aves en este lugar.</text>
    <text x="22" y="142" font-size="4.2">Si escuchaste algo, puedes contarlo o dibujarlo abajo.</text>
    <rect x="15" y="157" width="180" height="105" rx="4" fill="none" stroke="#796f67" stroke-width=".55" />
    <text x="22" y="169" font-size="5.4" font-weight="700">Dibuja un detalle o el lugar donde miraste.</text>
    <text x="15" y="278" font-weight="700">Señala algo que quieras observar la próxima vez.</text>
  </g>
</SheetFrame>
