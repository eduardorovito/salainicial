---
import SheetFrame from './SheetFrame.astro';

const cards = [
  { label: 'Manos limpias y secas', x: 15, y: 68, icon: 'manos' },
  { label: 'Pasa una página', x: 109, y: 68, icon: 'pagina' },
  { label: 'Devuelve el libro', x: 15, y: 166, icon: 'cesta' },
  { label: 'Pide ayuda', x: 109, y: 166, icon: 'ayuda' },
] as const;
---

<SheetFrame title="Cuidamos los libros" label="Cuatro tarjetas recortables con acciones para cuidar los libros del aula.">
  <g fill="#1f1a17" font-family="'Atkinson Hyperlegible Next', Arial, sans-serif">
    <text x="15" y="56" font-size="4.6">Mira la tarjeta y muestra cómo cuidar el libro.</text>
    {cards.map(({ label, x, y, icon }) => (
      <g transform={`translate(${x} ${y})`}>
        <rect width="86" height="88" rx="2" fill="none" stroke="#5c554d" stroke-width=".5" />
        <g transform="translate(18 12)" fill="none" stroke="#1f1a17" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round">
          {icon === 'manos' && (
            <>
              <path d="M10 42 7 29q0-3 3-3l3 5V15q0-3 3-3t3 3v8-12q0-3 3-3t3 3v12-10q0-3 3-3t3 3v12-7q0-3 3-3t3 3v16q0 8-7 13H17q-5-1-7-5Z" />
              <path d="m41 5 1.5 4L47 10l-4.5 1.5L41 16l-1.5-4.5L35 10l4.5-1Z" />
            </>
          )}
          {icon === 'pagina' && (
            <>
              <path d="M25 40C17 35 10 34 3 36V12c7-2 14 0 22 4 8-4 15-6 22-4v24c-7-2-14-1-22 4Zm0-24v24" />
              <path d="M26 17C32 11 36 6 35 3c7 2 11 9 9 15-5-1-12 0-18 3M8 20q6-1 11 2m-11 5q6-1 11 2" />
            </>
          )}
          {icon === 'cesta' && (
            <>
              <path d="M18 4h15v14H18zm4 4h7m-4 13v10m-4-4 4 4 4-4M5 34h40l-5 15H10zm11 4 2 7m7-7v7m9-7-2 7" />
            </>
          )}
          {icon === 'ayuda' && (
            <>
              <path d="M25 46c-7-4-14-5-22-3V27c8-2 15-1 22 3 7-4 14-5 22-3v16c-8-2-15-1-22 3Zm0-16v16" />
              <path d="M11 15V8q0-5 5-5h18q5 0 5 5v7q0 5-5 5H23l-7 5v-5q-5 0-5-5Z" />
              <circle cx="20" cy="12" r=".6" /><circle cx="25" cy="12" r=".6" /><circle cx="30" cy="12" r=".6" />
            </>
          )}
        </g>
        <text x="43" y="73" text-anchor="middle" font-size="6.2" font-weight="700">{label}</text>
      </g>
    ))}
  </g>
</SheetFrame>
