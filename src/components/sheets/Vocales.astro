---
import SheetFrame from './SheetFrame.astro';

// Una fila por vocal: modelo, dos letras grises para repasar y espacio para escribir sola.
const vocales = [
  { l: 'Aa', w: 'abeja' },
  { l: 'Ee', w: 'elefante' },
  { l: 'Ii', w: 'iguana' },
  { l: 'Oo', w: 'oso' },
  { l: 'Uu', w: 'uva' },
];
const font = "Andika, 'Atkinson Hyperlegible Next', Arial, sans-serif";
const top = 58;
const h = 44;
const rows = vocales.map((v, i) => {
  const y = top + i * h;
  return { ...v, y, base: y + 30, cap: y + 12, mid: y + 19 };
});
---

<SheetFrame title="Repasa las vocales" label="Ficha de vocales para repasar: A, E, I, O y U en mayúscula y minúscula, con letras grises para repasar y renglones para escribir">
  <text x="15" y="49" font-size="4" fill="#4a423d" font-family="'Atkinson Hyperlegible Next', Arial, sans-serif">
    Repasa las letras grises con tu lápiz. Después, escríbelas solo en el renglón.
  </text>
  {
    rows.map((r) => (
      <g>
        <rect x="15" y={r.y + 2} width="38" height="38" rx="4" fill="none" stroke="#c9c1bb" stroke-width="0.4" />
        <text x="34" y={r.base} font-size="22" font-family={font} font-weight="700" text-anchor="middle" fill="#1f1a17">{r.l}</text>
        <text x="34" y={r.y + 37} font-size="3.6" font-family={font} text-anchor="middle" fill="#4a423d">{r.w}</text>
        <line x1="60" y1={r.cap} x2="195" y2={r.cap} stroke="#d9d2cc" stroke-width="0.3" />
        <line x1="60" y1={r.mid} x2="195" y2={r.mid} stroke="#d9d2cc" stroke-width="0.3" stroke-dasharray="1.2 1.6" />
        <line x1="60" y1={r.base} x2="195" y2={r.base} stroke="#8f857e" stroke-width="0.45" />
        <text x="80" y={r.base} font-size="22" font-family={font} text-anchor="middle" fill="#d6cfca">{r.l}</text>
        <text x="118" y={r.base} font-size="22" font-family={font} text-anchor="middle" fill="#d6cfca">{r.l}</text>
      </g>
    ))
  }
</SheetFrame>
