---
import SheetFrame from './SheetFrame.astro';

const pez = [[32, 99, -7, 2], [49, 84, -6, -4], [76, 77, 0, -5], [104, 80, 0, -5], [132, 94, 0, -5], [166, 78, 4, -4], [155, 104, -6, 2], [166, 130, 6, 4], [131, 113, 0, 7], [106, 127, 1, 7], [76, 130, 0, 7], [49, 120, -4, 6]];
const cometa = [[106, 158, 0, -5], [122, 169, 4, -3], [139, 181, 5, -2], [156, 193, 7, 0], [142, 207, 7, 0], [124, 221, 7, 1], [106, 235, 7, 3], [88, 221, -6, 2], [70, 207, -6, 2], [54, 193, -7, 0], [72, 181, -7, -2], [89, 169, -6, -3]];
---

<SheetFrame title="Une los puntos del 1 al 12" label="Dos dibujos con puntos del 1 al 12 para unir. En el primero aparece un pez y en el segundo una cometa">
  <text x="15" y="50" font-size="4.4" fill="#1f1a17">Empieza en el 1. Al llegar al 12, vuelve al primer punto.</text>
  <path d="M15 146H195" stroke="#b9b3af" stroke-width="0.4" />
  <circle cx="53" cy="99" r="1.7" fill="none" stroke="#292421" stroke-width="0.65" />
  <path d="M106 236c2 7-6 8-5 15s9 7 8 15m-8-15-5-3v6l5-3 6-3v6Z" fill="none" stroke="#292421" stroke-width="0.65" />
  {[pez, cometa].map((puntos) => (
    <g fill="#292421">
      {puntos.map(([x, y, dx, dy], i) => (
        <g>
          <circle cx={x} cy={y} r="1.3" />
          <text x={x + dx} y={y + dy} text-anchor="middle" font-size="4.8" font-weight="700">{i + 1}</text>
        </g>
      ))}
    </g>
  ))}
</SheetFrame>
