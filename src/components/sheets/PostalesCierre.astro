---
import SheetFrame from './SheetFrame.astro';

const postales = ['Quiero recordar…', 'Gracias por…'];
---

<SheetFrame title="Postales para cerrar el año" label="Dos postales en blanco, una para recordar una experiencia y otra para agradecer algo compartido">
  <g font-family="'Atkinson Hyperlegible Next', Arial, sans-serif" fill="#1f1a17">
    <text x="15" y="53" font-size="4.6">Elige una postal. Dibuja algo que viviste en el aula.</text>
    <text x="15" y="62" font-size="4.6">Si quieres escribir un mensaje, puedes dictárselo a tu docente.</text>
    {postales.map((titulo, i) => (
      <g transform={`translate(0 ${70 + i * 105})`}>
        <rect x="15" y="0" width="180" height="98" rx="5" fill="none" stroke="#81756b" stroke-width="0.55" />
        <text x="22" y="11" font-size="5.3" font-weight="700">{titulo}</text>
        <rect x="22" y="16" width="166" height="57" rx="3" fill="none" stroke="#81756b" stroke-width="0.45" stroke-dasharray="2 2" />
        <line x1="22" x2="188" y1="83" y2="83" stroke="#81756b" stroke-width="0.45" />
        <line x1="22" x2="188" y1="92" y2="92" stroke="#81756b" stroke-width="0.45" />
      </g>
    ))}
    <path d="M15 171.5H195" fill="none" stroke="#81756b" stroke-dasharray="2 2" stroke-width="0.45" />
  </g>
</SheetFrame>
