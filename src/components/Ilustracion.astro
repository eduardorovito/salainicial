---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  imagen: ImageMetadata;
  class?: string;
  eager?: boolean;
  width?: number;
}

const { imagen, class: className, eager = false, width = imagen.width } = Astro.props;
---

<Image
  class={className}
  src={imagen}
  width={Math.min(width, imagen.width)}
  format="webp"
  quality={72}
  alt=""
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
