    { "source": "/articulos", "destination": "/blog/", "permanent": true },
    { "source": "/articulos/(.*)", "destination": "/blog/$1", "permanent": true },
    { "source": "/juegos/kamishibai-teatro-de-papel", "destination": "/cuentos/kamishibai-teatro-de-papel/", "permanent": true },
    { "source": "/juegos/kamishibai-teatro-de-papel/", "destination": "/cuentos/kamishibai-teatro-de-papel/", "permanent": true },
    { "source": "/juegos/origami-facil-para-preescolar", "destination": "/actividades/origami-facil-para-preescolar/", "permanent": true },
    { "source": "/juegos/origami-facil-para-preescolar/", "destination": "/actividades/origami-facil-para-preescolar/", "permanent": true }
  ]
}
